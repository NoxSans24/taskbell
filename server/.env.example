# Server Environment Configuration Template
PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/taskbell_db?schema=public"

# Wajib: secret acak minimal 48 karakter dengan variasi karakter yang cukup.
# Nilai contoh di bawah ini DITOLAK server sebagai pengaman.
# Buat nilai baru, misalnya: openssl rand -base64 48
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_characters_long"

# Opsional: daftar origin web yang diizinkan, dipisah koma.
# Kosong = hanya localhost/127.0.0.1 (mode pengembangan).
# Contoh produksi: CORS_ORIGINS="https://taskbell.example.com"
CORS_ORIGINS=""

# Set ke 1 bila server berada di belakang reverse proxy agar IP klien terbaca
# dengan benar oleh pembatas laju.
TRUST_PROXY=0

# Kunci enkripsi token bot Telegram (AES-256-GCM), 32 byte dalam base64.
# Buat dengan: openssl rand -base64 32
# Tanpa kunci ini, endpoint Telegram mengembalikan 503 dan pengingat nonaktif.
TELEGRAM_TOKEN_KEY=""

# Set ke 0 untuk mematikan pengirim pengingat terjadwal.
REMINDERS_ENABLED=1
