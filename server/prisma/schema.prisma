datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  tasks        Task[]
  categories   Category[]
  mutationLogs MutationLog[]
  syncChanges  SyncChange[]
  userSyncState UserSyncState?
  telegramLink TelegramLink?
  reminderDeliveries ReminderDelivery[]
}

model Task {
  id          String   @id @default(uuid())
  syncId      String   @unique @default(uuid())
  title       String
  description String?
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  priority    Int
  status      Int
  dueDate     DateTime?
  isDeleted   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  userId      String
}

model Category {
  id        String   @id @default(uuid())
  syncId    String   @unique @default(uuid())
  name      String
  isDeleted Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  tasks     Task[]

  @@unique([name, userId])
}

model MutationLog {
  id               String   @id @default(uuid())
  clientMutationId String   @unique
  userId           String
  syncId           String
  entityType       String
  operation        String
  payload          Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
}

model SyncChange {
  id         Int      @id @default(autoincrement())
  userId     String
  sequence   BigInt
  entityType String
  operation  String
  syncId     String
  payload    Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, sequence])
  @@index([userId, sequence])
}

model UserSyncState {
  userId     String @id
  sequence   BigInt @default(0)
  user       User   @relation(fields: [userId], references: [id])
}

/// Tautan bot Telegram milik pengguna. Token disimpan terenkripsi
/// (AES-256-GCM) dan tidak pernah dikembalikan ke klien.
model TelegramLink {
  userId         String   @id
  chatId         String
  tokenCipher    String
  enabled        Boolean  @default(true)
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Penanda pengingat yang sudah dikirim, mencegah pengiriman ganda
/// untuk tugas dan tenggat yang sama.
model ReminderDelivery {
  id         String   @id @default(uuid())
  userId     String
  taskSyncId String
  dueAt      DateTime
  sentAt     DateTime @default(now())
  status     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskSyncId, dueAt])
  @@index([userId, sentAt])
}
